{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"allowJs": true,
		"checkJs": true
	},
	"include": [
		"env.d.ts",
		"src/**/*.ts",
		"src/**/*.vue",
		"src/config.js",
		"scripts/**/*.mjs",
		"scripts/**/*.mts"
	]
}
