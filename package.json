{
	"name": "@dynamsoft-docs/vitepress-docs",
	"version": "0.1.0",
	"description": "Dynamsoft docs-site toolkit for VitePress: corporate chrome theme, version switcher and multi-version builds, config factory, and docs bins.",
	"license": "UNLICENSED",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dynamsoft-docs/vitepress-docs.git"
	},
	"bin": {
		"ds-docs-build-versions": "./scripts/build-versions.mjs",
		"ds-docs-npm-readme": "./scripts/npm-readme.mjs"
	},
	"files": [
		"src",
		"tsconfig.base.json",
		"typedoc.base.json",
		"README.md"
	],
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./config": "./src/config.js",
		"./tsconfig.base.json": "./tsconfig.base.json",
		"./typedoc.base.json": "./typedoc.base.json",
		"./package.json": "./package.json"
	},
	"scripts": {
		"sync-chrome": "node scripts/sync-chrome.mts",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "vp lint",
		"fmt": "vp fmt",
		"check": "vp check"
	},
	"dependencies": {
		"markdown-it-github-alerts": "^1.0.1",
		"vue": "^3.5.0"
	},
	"devDependencies": {
		"@types/node": "^24.0.0",
		"typescript": "^5.8.0",
		"vite-plus": "0.2.6",
		"vitepress": "2.0.0-alpha.18"
	},
	"peerDependencies": {
		"vitepress": "^1.6.0 || ^2.0.0-alpha.1"
	},
	"overrides": {
		"vite": "npm:@voidzero-dev/vite-plus-core@0.2.6"
	},
	"devEngines": {
		"packageManager": {
			"name": "npm",
			"version": "^11.11.0",
			"onFail": "error"
		},
		"runtime": {
			"name": "node",
			"version": "^24.0.0",
			"onFail": "error"
		}
	}
}
