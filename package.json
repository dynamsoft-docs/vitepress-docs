	"description": "Shared Dynamsoft VitePress theme: corporate header/footer chrome, docs version switcher, and brand styles.",
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts",
