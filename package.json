{
	"name": "dynamsoft-vitepress-theme",
	"version": "0.1.0",
	"description": "Shared Dynamsoft VitePress theme: corporate header/footer chrome, docs version switcher, and brand styles.",
	"bin": {
		"ds-docs-build-versions": "./scripts/build-versions.mjs",
		"ds-docs-npm-readme": "./scripts/npm-readme.mjs"
	},
	"files": [
		"src",
		"README.md"
	],
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./config": "./src/config.js",
		"./package.json": "./package.json"
	},
	"scripts": {
		"sync-chrome": "node scripts/sync-chrome.mts",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "vp lint",
		"fmt": "vp fmt",
		"check": "vp check"
	},
	"dependencies": {
		"markdown-it-github-alerts": "^1.0.1"
	},
	"devDependencies": {
		"@types/node": "^24.0.0",
		"typescript": "^5.8.0",
		"vite-plus": "0.2.4",
		"vitepress": "2.0.0-alpha.18",
		"vue": "^3.5.0"
	},
	"peerDependencies": {
		"vitepress": "^1.6.0 || ^2.0.0-alpha.1",
		"vue": "^3.5.0"
	},
	"engines": {
		"node": ">=20.19.0"
	}
}
